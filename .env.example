# 서버 포트. 기본값은 3000입니다.
PORT=3000

# 곡 신청 쿨타임(분). 기본값은 30입니다.
TRACK_COOLDOWN_MIN=30

# DB 접속 주소(필수)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# 로컬이 아닌 DB에 SSL 없이 접속할 때만 false로 설정합니다.
# DATABASE_SSL=false

# 카카오 로그인용 REST API 키(필수)
KAKAO_REST_API_KEY=

# 카카오 로그인 후 돌아올 프론트 콜백 주소(필수). 카카오 콘솔에 등록한 값과 프론트의 authorize 호출 값과 같아야 합니다.
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# 카카오 로그인용 클라이언트 시크릿(필수)
KAKAO_REST_API_CLIENT_SECRET=
